<!-- Shared HeyMelody / COUI look (HeyBlue theme): used by the main window and the tray flyout.
     Colours are DynamicResource keys filled in by Theme.cs (light/dark). Triggers never set a themed brush themselves
     (WPF doesn't always undo a trigger's DynamicResource value); they show or hide layers that already carry the brush. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Slim overlay-style scrollbar instead of the classic Windows one (Android shows none). -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="6"/>
    <Setter Property="MinWidth" Value="6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4,2,4">
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb"><Border CornerRadius="2" Background="{DynamicResource ScrollThumb}" Width="4"/></ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- WPF context menus (the ⋮ menu, gesture picker), Windows 11 style. The built-in template paints its own light icon
       column and separators, so menus, items and separators all get templates here. Menus sit in their own popup tree and
       don't inherit the window's font. -->
  <Style TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Grid Margin="6,2,6,10">
            <Border Background="{DynamicResource CardBg}" CornerRadius="8">
              <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.3"/></Border.Effect>
            </Border>
            <Border BorderBrush="{DynamicResource MenuBorder}" BorderThickness="1" CornerRadius="8" Padding="0,4">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Grid Background="Transparent" Margin="4,1">
            <Border x:Name="Hov" Background="{DynamicResource Selected}" CornerRadius="4" Visibility="Collapsed"/>
            <Grid MinHeight="32">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*" MinWidth="120"/>
                <ColumnDefinition Width="28"/>
              </Grid.ColumnDefinitions>
              <Path x:Name="Check" Data="M0,4.5 L3.5,8 L10,1" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
              <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
              <Path x:Name="Arrow" Grid.Column="2" Data="M0,0 L4,4 L0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-7" AllowsTransparency="True" Focusable="False"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
              <Grid Margin="6,2,6,10">
                <Border Background="{DynamicResource CardBg}" CornerRadius="8">
                  <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.3"/></Border.Effect>
                </Border>
                <Border BorderBrush="{DynamicResource MenuBorder}" BorderThickness="1" CornerRadius="8" Padding="0,4">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/>
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Hov" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Menus apply this key to their separators, not the implicit Separator style. -->
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator"><Border Height="1" Margin="0,4" Background="{DynamicResource Divider}"/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Desktop card: Windows 11 radius and hairline border; the page supplies the outer margins. -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBg}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="0,4"/>
  </Style>

  <!-- Section heading, as in Windows Settings. -->
  <Style x:Key="Category" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
    <Setter Property="Margin" Value="2,26,0,8"/>
  </Style>

  <!-- Page title on the Earbud controls and About pages. -->
  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="28"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
    <Setter Property="Margin" Value="2,0,0,4"/>
  </Style>

  <!-- Navigation pane item: accent pill on the left when selected, like Windows 11 Settings. -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
    <Setter Property="Margin" Value="0,2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Height="40" Background="Transparent">
            <Border x:Name="Hov" Background="{DynamicResource Hover}" CornerRadius="5" Visibility="Collapsed"/>
            <Border x:Name="Sel" Background="{DynamicResource Selected}" CornerRadius="5" Visibility="Collapsed"/>
            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Visibility="Collapsed"/>
            <ContentPresenter Margin="14,0,8,0" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hov" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Sel" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RowTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="RowSummary" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,2,0,0"/>
  </Style>

  <!-- A preference row inside a card: press highlight inset like COUICardListSelectedItemLayout. -->
  <Style x:Key="Row" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent" Margin="4,0" MinHeight="56">
            <Border x:Name="Hov" Background="{DynamicResource Hover}" CornerRadius="12" Visibility="Collapsed"/>
            <Border x:Name="Prs" Background="{DynamicResource Pressed}" CornerRadius="12" Visibility="Collapsed"/>
            <ContentPresenter Margin="12,8" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hov" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Prs" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- COUI switch: pill track, white thumb, accent when on. -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="40" Height="24">
            <Border CornerRadius="12" Background="{DynamicResource TrackOff}"/>
            <Border x:Name="On" CornerRadius="12" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2,0">
              <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="0.5" Opacity="0.2"/></Ellipse.Effect>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <!-- The setter places the thumb, so a switch created already-on starts at the right end; the
                 animation only shows when the state actually changes (it runs from the current position). -->
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="On" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Thumb" Property="Margin" Value="18,0,2,0"/>
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard><ThicknessAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Margin" To="18,0,2,0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard><Storyboard><ThicknessAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Margin" To="2,0,2,0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Noise mode button (melody_ui_normal_mode_button): 56dp circle, 24dp icon, label underneath. Tag = icon geometry. -->
  <Style x:Key="ModeButton" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Background="Transparent" HorizontalAlignment="Center">
            <Grid Width="56" Height="56" HorizontalAlignment="Center">
              <Ellipse Fill="{DynamicResource ModeBg}"/>
              <Ellipse x:Name="Hov" Fill="{DynamicResource ModeHover}" Visibility="Collapsed"/>
              <Ellipse x:Name="Sel" Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
              <Path x:Name="Icon" Width="24" Height="24" Stretch="Uniform" Fill="{DynamicResource ModeIcon}"
                    Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
              <Path x:Name="IconOn" Width="24" Height="24" Stretch="Uniform" Fill="White" Visibility="Collapsed"
                    Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Grid>
            <Grid Margin="0,6,0,0" HorizontalAlignment="Center" MaxWidth="84">
              <TextBlock x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                         FontSize="12" Foreground="{DynamicResource LabelSecondary}" TextAlignment="Center" TextWrapping="Wrap"/>
              <TextBlock x:Name="LabelOn" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Visibility="Collapsed"
                         FontSize="12" Foreground="{DynamicResource LabelPrimary}" TextAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hov" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Sel" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="IconOn" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Label" Property="Visibility" Value="Hidden"/>
              <Setter TargetName="LabelOn" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Width="40" Height="40" Background="Transparent">
            <Border x:Name="Hov" Background="{DynamicResource Hover}" CornerRadius="20" Visibility="Collapsed"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hov" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Left / Right selector on the Earbud controls page. -->
  <Style x:Key="SidePill" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Width="116" Height="40" Margin="6,0">
            <Border CornerRadius="20" Background="{DynamicResource SoftFill}"/>
            <Border x:Name="Sel" CornerRadius="20" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
            <TextBlock x:Name="T" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource LabelPrimary}"/>
            <TextBlock x:Name="TOn" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="16" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Sel" Property="Visibility" Value="Visible"/>
              <Setter TargetName="T" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="TOn" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- BassWave level: rounded accent track, white thumb. -->
  <Style x:Key="SliderFill" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton"><Border Background="{DynamicResource Accent}" CornerRadius="14,0,0,14" Margin="0,0,-14,0"/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderEmpty" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="LevelSlider" TargetType="Slider">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsSnapToTickEnabled" Value="True"/>
    <Setter Property="TickFrequency" Value="1"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="28">
            <Border CornerRadius="14" Background="{DynamicResource AccentSoft}"/>
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}"/></Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse Width="24" Height="24" Fill="White" Stroke="{DynamicResource Accent}" StrokeThickness="2">
                        <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="0.5" Opacity="0.2"/></Ellipse.Effect>
                      </Ellipse>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PillButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border CornerRadius="14" Background="{DynamicResource AccentSoft}"/>
            <Border x:Name="Hov" CornerRadius="14" Background="{DynamicResource AccentSoftHover}" Visibility="Collapsed"/>
            <TextBlock Margin="14,4" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hov" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
