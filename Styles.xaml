<!-- Shared HeyMelody / COUI look (HeyBlue theme): used by the main window and the tray flyout. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Accent" Color="#0A7FFB"/>
  <SolidColorBrush x:Key="LabelPrimary" Color="#E6000000"/>
  <SolidColorBrush x:Key="LabelSecondary" Color="#8A000000"/>
  <SolidColorBrush x:Key="LabelTertiary" Color="#42000000"/>
  <SolidColorBrush x:Key="Divider" Color="#14000000"/>

  <!-- Slim overlay-style scrollbar instead of the classic Windows one (Android shows none). -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="6"/>
    <Setter Property="MinWidth" Value="6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4,2,4">
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb"><Border CornerRadius="2" Background="#33000000" Width="4"/></ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Desktop card: Windows 11 radius and hairline border; the page supplies the outer margins. -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="White"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BorderBrush" Value="#0F000000"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="0,4"/>
  </Style>

  <!-- Section heading, as in Windows Settings. -->
  <Style x:Key="Category" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource LabelPrimary}"/>
    <Setter Property="Margin" Value="2,26,0,8"/>
  </Style>

  <!-- Page title on the Earbud controls and About pages. -->
  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="28"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
    <Setter Property="Margin" Value="2,0,0,4"/>
  </Style>

  <!-- Navigation pane item: accent pill on the left when selected, like Windows 11 Settings. -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Foreground" Value="{StaticResource LabelPrimary}"/>
    <Setter Property="Margin" Value="0,2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Height="40">
            <Border x:Name="B" Background="Transparent" CornerRadius="5"/>
            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource Accent}" HorizontalAlignment="Left" Visibility="Collapsed"/>
            <ContentPresenter Margin="14,0,8,0" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#0A000000"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="B" Property="Background" Value="#0F000000"/>
              <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RowTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Foreground" Value="{StaticResource LabelPrimary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="RowSummary" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource LabelSecondary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,2,0,0"/>
  </Style>

  <!-- A preference row inside a card: press highlight inset like COUICardListSelectedItemLayout. -->
  <Style x:Key="Row" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="Transparent" CornerRadius="12" Margin="4,0" Padding="12,8" MinHeight="56">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#0A000000"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#14000000"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- COUI switch: pill track, white thumb, accent when on. -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="40" Height="24">
            <Border x:Name="Track" CornerRadius="12" Background="#26000000"/>
            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2,0">
              <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="0.5" Opacity="0.2"/></Ellipse.Effect>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <!-- The setter places the thumb, so a switch created already-on starts at the right end; the
                 animation only shows when the state actually changes (it runs from the current position). -->
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
              <Setter TargetName="Thumb" Property="Margin" Value="18,0,2,0"/>
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard><ThicknessAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Margin" To="18,0,2,0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard><Storyboard><ThicknessAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Margin" To="2,0,2,0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Noise mode button (melody_ui_normal_mode_button): 56dp circle, 24dp icon, label underneath. Tag = icon geometry. -->
  <Style x:Key="ModeButton" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Background="Transparent" HorizontalAlignment="Center">
            <Grid Width="56" Height="56" HorizontalAlignment="Center">
              <Ellipse x:Name="Bg" Fill="#EBEBEB"/>
              <Path x:Name="Icon" Width="24" Height="24" Stretch="Uniform" Fill="#D9000000"
                    Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Grid>
            <TextBlock x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                       FontSize="12" Foreground="{StaticResource LabelSecondary}" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="84" Margin="0,6,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Fill" Value="#E0E0E0"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bg" Property="Fill" Value="{StaticResource Accent}"/>
              <Setter TargetName="Icon" Property="Fill" Value="White"/>
              <Setter TargetName="Label" Property="Foreground" Value="{StaticResource LabelPrimary}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="Transparent" CornerRadius="20" Width="40" Height="40">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#0F000000"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Left / Right selector on the Earbud controls tab. -->
  <Style x:Key="SidePill" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="B" Background="#EBEBEB" CornerRadius="20" Width="116" Height="40" Margin="6,0">
            <TextBlock x:Name="T" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource LabelPrimary}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="B" Property="Background" Value="{StaticResource Accent}"/>
              <Setter TargetName="T" Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- BassWave level: rounded accent track, white thumb. -->
  <Style x:Key="SliderFill" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton"><Border Background="{StaticResource Accent}" CornerRadius="14,0,0,14" Margin="0,0,-14,0"/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderEmpty" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="LevelSlider" TargetType="Slider">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsSnapToTickEnabled" Value="True"/>
    <Setter Property="TickFrequency" Value="1"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="28">
            <Border CornerRadius="14" Background="#260A7FFB"/>
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}"/></Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse Width="24" Height="24" Fill="White" Stroke="{StaticResource Accent}" StrokeThickness="2">
                        <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="0.5" Opacity="0.2"/></Ellipse.Effect>
                      </Ellipse>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PillButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="#260A7FFB" CornerRadius="14" Padding="14,4">
            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#400A7FFB"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
