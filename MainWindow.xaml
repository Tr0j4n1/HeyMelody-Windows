<!-- Desktop layout in the style of Windows 11 Settings: navigation pane on the left, content on the right.
     The controls inside (noise buttons, switches, slider, cards) keep the HeyMelody look. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MelodyDesk" Width="1040" Height="720" MinWidth="720" MinHeight="520"
        Background="{DynamicResource WindowBg}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="{DynamicResource LabelPrimary}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <!-- Navigation pane -->
    <DockPanel Margin="10,14,6,14">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,8,22">
        <Image x:Name="AppIcon" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="MelodyDesk" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock x:Name="NavFooter" DockPanel.Dock="Bottom" Margin="12,0,8,4" FontSize="12" Foreground="{DynamicResource LabelSecondary}" TextWrapping="Wrap"/>
      <StackPanel x:Name="NavItems"/>
    </DockPanel>

    <!-- Content -->
    <Border Grid.Column="1" Background="{DynamicResource ContentBg}" CornerRadius="8,0,0,0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,1,0,0">
      <Grid>
        <!-- Device page -->
        <ScrollViewer x:Name="MainPage" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="36,28,36,36" MaxWidth="1000">
            <Border Style="{StaticResource Card}" Padding="20,16,12,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="Product" Width="150" Height="150" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="DeviceName" Text="Earbuds" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                             FontFamily="Segoe UI Variable Display, Segoe UI"/>
                  <StackPanel x:Name="HeroStatus" Orientation="Horizontal" Margin="0,6,0,0"/>
                  <WrapPanel x:Name="HeroBattery" Margin="0,14,0,0"/>
                </StackPanel>
                <Button x:Name="MenuButton" Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Top" ToolTip="More" AutomationProperties.Name="More options">
                  <StackPanel>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource LabelPrimary}" Margin="0,1"/>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource LabelPrimary}" Margin="0,1"/>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource LabelPrimary}" Margin="0,1"/>
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
            <StackPanel x:Name="Cards"/>
          </StackPanel>
        </ScrollViewer>

        <!-- Earbud controls page -->
        <ScrollViewer x:Name="ControlsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel x:Name="ControlsContent" Margin="36,28,36,36" MaxWidth="1000"/>
        </ScrollViewer>

        <!-- About page -->
        <ScrollViewer x:Name="AboutPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel x:Name="AboutContent" Margin="36,28,36,36" MaxWidth="1000"/>
        </ScrollViewer>

        <!-- Sub page (Sound Master EQ, Dual connection, Find my earbuds, More settings), shown over the Device page -->
        <DockPanel x:Name="SubPage" Background="{DynamicResource ContentBg}" Visibility="Collapsed">
          <Grid DockPanel.Dock="Top" Margin="26,22,36,0" MaxWidth="1010">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BackButton" Style="{StaticResource IconButton}" ToolTip="Back" AutomationProperties.Name="Back" VerticalAlignment="Center">
                <Path Data="M7,0 L0,7 L7,14 M0,7 H15" Stroke="{DynamicResource LabelPrimary}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Button>
              <TextBlock x:Name="SubCrumb" Text="Device" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource LabelSecondary}" Margin="6,0,0,0" VerticalAlignment="Center"
                         Cursor="Hand" FontFamily="Segoe UI Variable Display, Segoe UI"/>
              <Path Data="M0,0 L6,6 L0,12" Stroke="{DynamicResource LabelSecondary}" StrokeThickness="1.6" StrokeLineJoin="Round" Margin="14,4,14,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="SubTitle" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"/>
            </StackPanel>
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SubContent" Margin="36,4,36,36" MaxWidth="1000"/>
          </ScrollViewer>
        </DockPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
